{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-clang",
            "displayName": "Windows (Clang + vcpkg)",
            "description": "Known-working Clang/libomp/vcpkg configuration - kept in sync with the 'Configuring locally' section of CONTRIBUTING.md.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "DEEPITY_BUILD_TESTS": "ON",
                "OpenMP_CXX_FLAGS": "-fopenmp=libomp",
                "OpenMP_CXX_LIB_NAMES": "libomp",
                "OpenMP_libomp_LIBRARY": "C:/Program Files/LLVM/lib/libomp.lib",
                "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "BLA_VENDOR": "OpenBLAS"
            }
        },
        {
            "name": "CLANG",
            "displayName": "Clang 22.1.8 x86_64-redhat-linux-gnu",
            "description": "Using compilers: C = /usr/bin/clang, CXX = /usr/bin/clang++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gpu",
            "displayName": "Linux GPU (CUDA + Python 3.12)",
            "description": "Cloud GPU instance configuration -- Python 3.12 pinned explicitly (avoids Ubuntu 22.04's default python3 resolving to the system's 3.10, which has no nanobind installed and no ABI match with anything built here). CMAKE_CUDA_ARCHITECTURES set for Ampere (compute_86, matches RTX 3090/A4000/etc) -- change to 89 for Ada Lovelace (RTX 4060 Ti/4070/4090), 80 for A100, 90 for H100.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Release",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "Python_EXECUTABLE": "${sourceDir}/.venv/bin/python3.12",
                "DEEPITY_ENABLE_CUDA": "ON",
                "CMAKE_CUDA_ARCHITECTURES": "80",
                "CMAKE_CUDA_STANDARD": "17"
            }
        }
    ]
}