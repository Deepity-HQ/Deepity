#pragma omp parallel for schedule(static) if (n > 65536)
        for (size_t i = 0; i < simd_end; i += 16)
        {
            __m512 x_512 = _mm512_load_ps(x + i);

            __m512 res = Sleef_logf16_u10avx512f(x_512);

