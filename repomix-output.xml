#define TANH_TINYLIMIT 0.000244140625f
#define TANH_POLY_LIMIT 0.625f
#define TANH_BIGLIMIT 6.0f

#define P0 -0.9643991794f
#define P1 -99.28772310f
#define P2 -1614.687684f

