#elif defined(__AVX2__)
        simd_end = n - (n % 8);
#pragma omp parallel for schedule(static) if (n > 65536)
        for (size_t i = 0; i < simd_end; i += 8)
        {
            __m256 x_256 = _mm256_load_ps(x + i);

            __m256 res = Sleef_logf8_u10avx2(x_256);

            _mm256_store_ps(x + i, res);
